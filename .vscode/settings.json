{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"[svelte]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"eslint.useFlatConfig": true,
	"eslint.validate": [
		"javascript",
		"typescript",
		"svelte"
	],
	"editor.formatOnSaveMode": "modifications"
}